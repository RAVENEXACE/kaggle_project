s_available(), \"Enable a GPU in Kaggle settings.\"\nassert image_size == 384, \"Use the same 384 × 384 inputs as ResNet50.\"\n\ndense_train_labels = loader_manifest.loc[\n    loader_manifest[\"split\"].eq(\"train\"), \"pe_present_on_image\"\n]\n\ndense_positive = int(dense_train_labels.eq(1).sum())\ndense_negative = int(dense_train_labels.eq(0).sum())\n\nassert (dense_negative, dense_positive) == (912_444, 51_328), (\n    f\"Training split counts differ from Stage 5: \"\n    f\"{dense_negative:,} negative, {dense_positive:,} positive.\"\n)\n\ndense_split_config = {\"bce_pos_weight\": dense_negative / dense_positive}\nprint(f\"Training pos_weight: {dense_split_config['bce_pos_weight']:.4f}\")\n\n\ndef check_densenet121():\n    torch.manual_seed(42)\n    device = torch.device(\"cuda:0\")\n    torch.cuda.empty_cache()\n    torch.cuda.reset_peak_memory_stats(device)\n\n    model = densenet121(weights=DenseNet121_Weights.DEFAULT)\n    model.classifier = nn.Linear(model.classifier.in_features, 1)\n    model = model.to(device).train()\n\n    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4)\n    loss_fn = nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor([dense_split_config[\"bce_pos_weight\"]], device=device)\n    )\n    scaler = torch.amp.GradScaler(\"cuda\", init_scale=1024.0)\n\n    train_stream = PEImageStream(\"train\", seed=42)\n    batches = iter(DataLoader(\n        train_stream,\n        batch_size=dense_batch_size,\n        num_workers=0,\n        pin_memory=True,\n    ))\n\n    timed_updates = 0\n    timed_images = 0\n\n    for step in range(dense_warmup_steps + dense_timed_steps):\n        if step == dense_warmup_steps:\n            torch.cuda.synchronize(device)\n            started_at = perf_counter()\n\n        images, labels, _ = next(batches)\n        images = images.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n        with torch.autocast(\"cuda\", dtype=torch.float16):\n            logits = model(images).squeeze(1)\n            assert logits.shape == labels.shape\n            loss = loss_fn(logits, labels)\n\n        if not torch.isfinite(loss).item():\n            raise FloatingPointError(f\"Non-finite loss at step {step + 1}.\")\n\n        scale_before = scaler.get_scale()\n        scaler.scale(loss).backward()\n        scaler.unscale_(optimizer)\n        nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        scaler.step(optimizer)\n        scaler.update()\n\n        if step >= dense_warmup_steps:\n            timed_updates += int(scaler.get_scale() >= scale_before)\n            timed_images += labels.numel()\n\n    torch.cuda.synchronize(device)\n    speed = timed_images / (perf_counter() - started_at)\n\n    print(\"=== Stage 14A DenseNet121 check ===\")\n    print(f\"GPU: {torch.cuda.get_device_name(device)}\")\n    print(f\"Image size: {image_size} × {image_size} | Batch size: {dense_batch_size}\")\n    print(f\"Timed optimizer updates: {timed_updates}/{dense_timed_steps}\")\n    print(f\"Peak reserved GPU memory: {torch.cuda.max_memory_reserved(device) / 2**30:.2f} GiB\")\n    print(f\"Training speed: {speed:.1f} images/s\")\n    print(f\"Estimated training time per epoch: {len(train_stream) / speed / 3600:.2f} hours\")\n    assert timed_updates > 0, \"No timed optimizer updates succeeded.\"\n\n\ncheck_densenet121()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T06:10:39.561672Z","iopub.execute_input":"2026-11-21T06:10:39.562118Z","iopub.status.idle":"2026-11-21T06:10:51.902334Z","shell.execute_reply.started":"2026-11-21T06:10:39.562089Z","shell.execute_reply":"2026-11-21T06:10:51.901541Z"}},"outputs":[{"name":"stdout","text":"Training pos_weight: 17.7767\nDownloading: \"https://download.pytorch.org/models/densenet121-a639ec97.pth\" to /root/.cache/torch/hub/checkpoints/densenet121-a639ec97.pth\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 30.8