evices([], \"GPU\")\nexcept RuntimeError:\n    print(\"TensorFlow devices are already initialized. Reading records on the CPU.\")\n\nimage_size = 384\nloader_seed = 42\n\nmanifest_path = Path(\"/kaggle/working/pe_splits/image_split_manifest.csv.gz\")\nbackup_input = Path(\"/kaggle/input/datasets/ravenex/backup\")\nloader_columns = [\n    \"tfrecord_file\",\n    \"record_number\",\n    \"image_name\",\n    \"pe_present_on_image\",\n    \"split\",\n]\n\n# Read the manifest from the working folder or the attached backup.\nif manifest_path.is_file():\n    print(f\"Using manifest: {manifest_path}\")\n    loader_manifest = pd.read_csv(manifest_path, usecols=loader_columns)\nelse:\n    if not backup_input.is_dir():\n        raise FileNotFoundError(\n            f\"Backup input missing: {backup_input}. \"\n            \"Attach the epoch 1 backup under Kaggle's Input panel.\"\n        )\n\n    manifest_files = sorted(backup_input.rglob(\"image_split_manifest.csv.gz\"))\n    if not manifest_files:\n        manifest_files = sorted(backup_input.rglob(\"image_split_manifest.csv\"))\n\n    if len(manifest_files) == 1:\n        print(f\"Using manifest: {manifest_files[0]}\")\n        loader_manifest = pd.read_csv(manifest_files[0], usecols=loader_columns)\n    elif len(manifest_files) > 1:\n        raise ValueError(f\"Found multiple manifest files: {manifest_files}\")\n    else:\n        backup_zips = sorted(backup_input.rglob(\"resnet50_epoch1_backup.zip\"))\n        if len(backup_zips) != 1:\n            raise FileNotFoundError(\n                f\"Expected a manifest or one backup ZIP in {backup_input}. \"\n                f\"Found ZIPs: {backup_zips}\"\n            )\n\n        print(f\"Reading manifest from: {backup_zips[0]}\")\n        with ZipFile(backup_zips[0]) as archive:\n            with archive.open(\"pe_splits/image_split_manifest.csv.gz\") as source:\n                loader_manifest = pd.read_csv(\n                    source, compression=\"gzip\", usecols=loader_columns\n                )\n\nassert len(loader_manifest) == 1_208_138, \"Manifest row count differs from Stage 5.\"\nassert not loader_manifest.duplicated([\"tfrecord_file\", \"record_number\"]).any()\nassert loader_manifest[\"pe_present_on_image\"].isin([0, 1]).all()\n\npaths_by_name = {path.name: path for path in tfrecord_files}\nmissing_shards = set(loader_manifest[\"tfrecord_file\"]) - paths_by_name.keys()\nassert not missing_shards, f\"Missing TFRecord files: {sorted(missing_shards)}\"\n\n# ImageNet normalization for pretrained models.\nrgb_mean = (0.485, 0.456, 0.406)\nrgb_std = (0.229, 0.224, 0.225)\n\nresize_image = transforms.Resize(\n    (image_size, image_size),\n    interpolation=InterpolationMode.BILINEAR,\n)\nnormalize_image = transforms.Normalize(rgb_mean, rgb_std)\n\ntrain_transform = transforms.Compose([\n    resize_image,\n    transforms.RandomAffine(\n        degrees=5,\n        translate=(0.02, 0.02),\n        interpolation=InterpolationMode.BILINEAR,\n        fill=0,\n    ),\n    transforms.ColorJitter(brightness=0.08, contrast=0.08),\n    transforms.ToTensor(),\n    normalize_image,\n])\n\neval_transform = transforms.Compose([\n    resize_image,\n    transforms.ToTensor(),\n    normalize_image,\n])\n\n\nclass PEImageStream(IterableDataset):\n    def __init__(self, split, seed=loader_seed, shuffle_buffer=512):\n        super().__init__()\n        if split not in {\"train\", \"validation\", \"test\"}:\n            raise ValueError(f\"Unknown split: {split}\")\n        if shuffle_buffer < 1:\n            raise ValueError(\"shuffle_buffer must be at least 1.\")\n\n        self.split = split\n        self.seed = seed\n        self.epoch = 0\n        self.shuffle_buffer = shuffle_buffer\n        self.transform = train_transform if split == \"train\" else eval_transform\n        self.rows_by_shard = {}\n\n        split_rows = loader_manifest.loc[loader_manifest[\"split\"].eq(split)]\n        if split_rows.empty:\n            raise ValueError(f\"No manifest rows for {split}.\")\n\n        columns = [\"record_number\", \"image_name\", \"pe_present_on_image\"]\n        for shard, rows in split_rows.groupby(\"tfrecord_file\", sort=True):\n            self.rows_by_shard[shard] = {\n                number: (image_id, label)\n                for number, image_id, label in rows[columns].itertuples(\n                    index=False, name=None\n                )\n            }\n\n        self.sample_count = len(split_rows)\n\n    def __len__(self):\n        return self.sample_count\n\n    def set_epoch(self, epoch):\n        self.epoch = epoch\n\n    def _records(self, rng):\n        shard_names = list(self.rows_by_shard)\n        if self.split == \"train\":\n            rng.shuffle(shard_names)\n\n        for shard in shard_names:\n            selected = self.rows_by_shard[shard]\n            last_record = max(selected)\n            records_found = 0\n\n            with tf.device(\"/CPU:0\"):\n                records = tf.data.TFRecordDataset(str(paths_by_name[shard]))\n                for number, raw in enumerate(\n                    records.take(last_record).as_numpy_iterator(), start=1\n                ):\n                    entry = selected.get(number)\n                    if entry is None:\n                        continue\n\n                    expected_id, label = entry\n                    features = tf.train.Example.FromString(raw).features.feature\n                    image_id = features[\"image_name\"].bytes_list.value[0].decode(\"utf-8\")\n\n                    if image_id != expected_id:\n                        raise ValueError(\n                            f\"Manifest mismatch in {shard}, record {number}. \"\n                            f\"Expected {expected_id}, found {image_id}.\"\n                        )\n\n                    jpeg = features[\"image\"].bytes_list.value[0]\n                    records_found += 1\n                    yield jpeg, label, image_id\n\n            if records_found != len(selected):\n                raise ValueError(\n                    f\"{shard}: read {records_found} of {len(selected)} expected records.\"\n                )\n\n    def _shuffle_records(self, records, rng):\n        # Buffer compressed JPEGs to keep memory use low.\n        buffer = []\n        for record in records:\n            if len(buffer) < self.shuffle_buffer:\n                buffer.append(record)\n                continue\n\n            index = rng.randrange(len(buffer))\n            selected = buffer[index]\n            buffer[index] = record\n            yield selected\n\n        rng.shuffle(buffer)\n        yield from buffer\n\n    def __iter__(self):\n        if get_worker_info() is not None:\n            raise RuntimeError(\"Use num_workers=0 with this TensorFlow-backed loader.\")\n\n        rng = random.Random(self.seed + self.epoch)\n        records = self._records(rng)\n        if self.split == \"train\":\n            records = self._shuffle_records(records, rng)\n\n        for jpeg, label, image_id in records:\n            try:\n                with Image.open(io.BytesIO(jpeg)) as image:\n                    if image.format != \"JPEG\":\n                        raise ValueError(f\"Expected JPEG, got {image.format}.\")\n                    image_tensor = self.transform(image.convert(\"RGB\"))\n            except (OSError, ValueError) as error:\n                raise RuntimeError(f\"Could not decode or preprocess {image_id}.\") from error\n\n            yield image_tensor, torch.tensor(label, dtype=torch.float32), image_id\n\n\nprint(f\"Manifest rows loaded: {len(loader_manifest):,}\")\nprint(\"2D image loader is ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T06:52:20.79197Z","iopub.execute_input":"2026-11-21T06:52:20.792453Z","iopub.status.idle":"2026-11-21T06:52:27.076579Z","shell.execute_reply.started":"2026-11-21T06:52:20.792416Z","shell.execute_reply":"2026-11-21T06:52:27.075858Z"}},"outputs":[{"name":"stdout","