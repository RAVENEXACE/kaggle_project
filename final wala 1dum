s,\nconfusion matrix, calibration plot, and per-image predictions.\n\nExpected output: Progress every 500 batches, a test metrics summary,\ntwo plots, and three saved files.","metadata":{}},{"cell_type":"code","source":"import json\nfrom pathlib import Path\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom sklearn.calibration import calibration_curve\nfrom sklearn.metrics import (\n    ConfusionMatrixDisplay,\n    accuracy_score,\n    average_precision_score,\n    brier_score_loss,\n    confusion_matrix,\n    f1_score,\n    precision_score,\n    recall_score,\n    roc_auc_score,\n)\nfrom torch import nn\nfrom torch.utils.data import DataLoader\nfrom torchvision.models import resnet50\n\nworking = Path(\"/kaggle/working\")\ntest_checkpoint_path = working / \"resnet50_baseline/best.pt\"\ntest_threshold_path = working / \"resnet50_validation/decision_threshold.json\"\n\nassert test_checkpoint_path.is_file(), f\"Restore {test_checkpoint_path}\"\nassert test_threshold_path.is_file(), f\"Restore {test_threshold_path}\"\nassert torch.cuda.is_available(), \"Enable a GPU in Kaggle settings.\"\n\nthreshold_config = json.loads(test_threshold_path.read_text(encoding=\"utf-8\"))\nassert threshold_config[\"model\"] == \"resnet50\"\nassert threshold_config[\"checkpoint_epoch\"] == 1\nassert threshold_config[\"selection_split\"] == \"validation\"\nassert threshold_config[\"score_type\"] == \"sigmoid of model logit\"\ntest_threshold = float(threshold_config[\"threshold\"])\nassert 0.0 < test_threshold < 1.0\n\ntest_checkpoint = torch.load(\n    test_checkpoint_path, map_location=\"cpu\", weights_only=True\n)\nassert test_checkpoint[\"epoch\"] == threshold_config[\"checkpoint_epoch\"]\nassert test_checkpoint[\"config\"][\"image_size\"] == image_size == 384\n\ntest_device = torch.device(\"cuda:0\")\ntest_model = resnet50(weights=None)\ntest_model.fc = nn.Linear(test_model.fc.in_features, 1)\ntest_model.load_state_dict(test_checkpoint[\"model\"])\ntest_model = test_model.to(test_device).eval()\ndel test_checkpoint\n\ntest_stream = PEImageStream(\"test\")\nassert len(test_stream) == 122_303\n\ntest_loader = DataLoader(\n    test_stream, batch_size=16, num_workers=0, pin_memory=True\n)\n\nscore_batches = []\nlabel_batches = []\ntest_ids = []\n\nprint(f\"Scoring the test set with the fixed threshold {test_threshold:.16g}\",\n      flush=True)\n\nwith torch.inference_mode():\n    for batch_number, (images, labels, image_ids) in enumerate(test_loader, 1):\n        images = images.to(test_device, non_blocking=True)\n\n        with torch.autocast(\"cuda\", dtype=torch.float16):\n            logits = test_model(images).squeeze(1)\n\n        score_batches.append(logits.float().sigmoid().cpu().numpy())\n        label_batches.append(labels.numpy())\n        test_ids.extend(image_ids)\n\n        if batch_number % 500 == 0:\n            print(f\"Test batches: {batch_number:,}/{len(test_loader):,}\", flush=True)\n\ntest_scores = np.concatenate(score_batches)\ntest_labels = np.concatenate(label_batches).astype(int)\n\nassert len(test_scores) == len(test_labels) == len(test_ids) == 122_303\nassert len(set(test_ids)) == len(test_ids), \"Duplicate test image IDs.\"\nassert int(test_labels.sum()) == 6_243\nassert np.isfinite(test_scores).all(), \"Some test scores are non-finite.\"\n\ntest_predictions = (test_scores >= test_threshold).astype(int)\nmatrix = confusion_matrix(test_labels, test_predictions, labels=[0, 1])\ntn, fp, fn, tp = (int(value) for value in matrix.ravel())\ntest_prevalence = float(test_labels.mean())\n\ntest_metrics = {\n    \"model\": \"resnet50\",\n    \"checkpoint_epoch\": 1,\n    \"evaluation_split\": \"test\",\n    \"threshold_selection_split\": \"validation\",\n    \"threshold\": test_threshold,\n    \"test_slices\": len(test_labels),\n    \"positive_slices\": int(test_labels.sum()),\n    \"positive_rate\": test_prevalence,\n    \"average_precision\": float(average_precision_score(test_labels, t