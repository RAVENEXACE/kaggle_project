n        }, temporary_path)\n        temporary_path.replace(pilot_checkpoint_path)\n        print(f\"Saved best checkpoint from round {round_number}.\", flush=True)\n\n    pd.DataFrame(pilot_history).to_csv(pilot_history_path, index=False)\n    print(f\"  Validation AP: {val_ap:.4f} | ROC-AUC: {val_roc_auc:.4f}\", flush=True)\n\nprint(\"\\n=== Stage 9 pilot results ===\")\nprint(pd.DataFrame(pilot_history).round(4).to_string(index=False))\nprint(f\"Pilot validation positive rate: {pilot_val_positives / pilot_val_size:.2%}\")\n\nfor path in (pilot_checkpoint_path, pilot_history_path):\n    assert path.is_file() and path.stat().st_size > 0, f\"Missing output: {path}\"\n    print(f\"Saved: {path} ({path.stat().st_size / 1024**2:.2f} MiB)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-20T11:20:07.527835Z","iopub.execute_input":"2026-11-20T11:20:07.528627Z","iopub.status.idle":"2026-11-20T11:22:40.813302Z","shell.execute_reply.started":"2026-11-20T11:20:07.528602Z","shell.execute_reply":"2026-11-20T11:22:40.812524Z"}},"outputs":[{"name":"stdout","text":"Round 1: trained on 1,600 slices, 100/100 updates. Starting validation...\nSaved best checkpoint from round 1.\n  Validation AP: 0.0958 | ROC-AUC: 0.7278\nRound 2: trained on 1,600 slices, 100/100 updates. Starting validation...\n  Validation AP: 0.0562 | ROC-AUC: 0.4914\n\n=== Stage 9 pilot results ===\n round  train_slices  successful_updates  train_loss  validation_loss  validation_ap  validation_roc_auc  elapsed_seconds\n     1          1600                 100      1.5431           1.8195         0.0958              0.7278             81.2\n     2          1600                 100      0.9706           3.9693         0.0562              0.4914             71.9\nPilot validation positive rate: 5.76%\nSaved: /kaggle/working/resnet50_pilot/best_resnet50.pt (89.99 MiB)\nSaved: /kaggle/working/resnet50_pilot/pilot_history.csv (0.00 MiB)\n","output_type":"stream"}],"execution_count":33},{"cell_type":"markdown","source":"## Stage 10A — Set up full ResNet50 training\n\nUse the saved splits and training class weight. Define full training\nand validation passes, learning-rate scheduling, early stopping,\nand checkpoints that can be resumed.\n\nExpected output: A setup message and the output folder.","metadata":{}},{"cell_type":"code","source":"import json\nfrom collections import defaultdict\nfrom pathlib import Path\nfrom time import perf_counter\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom sklearn.metrics import average_precision_score, roc_auc_score\nfrom torch import nn\nfrom torch.utils.data import DataLoader\nfrom torchvision.models import ResNet50_Weights, resnet50\n\nbaseline_dir = Path(\"/kaggle/working/resnet50_baseline\")\nbaseline_dir.mkdir(parents=True, exist_ok=True)\n\nbaseline_latest = baseline_dir / \"latest.pt\"\nbaseline_best = baseline_dir / \"best.pt\"\nbaseline_history = baseline_dir / \"history.csv\"\n\nbaseline_split_config = json.loads(\n    Path(\"/kaggle/working/pe_splits/split_config.json\").read_text(encoding=\"utf-8\")\n)\n\nbaseline_config = {\n    \"model\": \"resnet50\",\n    \"weights\": ResNet50_Weights.DEFAULT.name,\n    \"image_size\": 384,\n    \"batch_size\": 16,\n    \"seed\": 42,\n    \"learning_rate\": 1e-4,\n    \"pos_weight\": baseline_split_config[\"bce_pos_weight\"],\n    \"checkpoint_every\": 2000,\n    \"max_epochs\": 5,\n    \"early_stopping_patience\": 3,\n}\n\nassert torch.cuda.is_available(), \"Enable a GPU in Kaggle settings.\"\nassert image_size == baseline_config[\"image_size\"], \"Expected the Stage 6 resize of 384.\"\nbaseline_device = torch.device(\"cuda:0\")\n\n\ndef save_baseline_checkpoint(payload, path):\n    temporary_path = path.with_suffix(\".tmp\")\n    torch.save(payload, temporary_path)\n    temporary_path.replace(path)\n\n\n@torch.inference_mode()\ndef validate_baseline(model, loader, loss_fn):\n    model.eval()\n    loss_sum = 0.0\n    scores = []\n    targets = []\n\n    for images, labels, _ in loader:\n        images = images.to(baseline_device, non_blocking=True)\n        labels = labels.to(baseline_device, non_blocking=True)\n\n        with torch.autocast(\"cuda\", dtype=torch.float16):\n            logits = model(images).squeeze(1)\n\n        logits = logits.float()\n        loss = loss_fn(logits, labels)\n        if not torch.isfinite(loss).item():\n            raise FloatingPointError(\"Non-finite validation loss.\")\n\n        loss_sum += loss.item() * labels.numel()\n        scores.append(logits.cpu().numpy())\n        targets.append(labels.cpu().numpy())\n\n    scores = np.concatenate(scores)\n    targets = np.concatenate(targets)\n    assert len(targets) == 122_063 and int(targets.sum()) == 6_023\n\n    return {\n        \"validation_loss\": loss_sum / len(targets),\n        \"validation_ap\": float(average_precision_score(targets, scores)),\n        \"validation_roc_auc\": float(roc_auc_score(targets, scores)),\n    }\n\n\ndef run_resnet50_baseline(epochs_this_run=1):\n    assert epochs_this_run >= 1\n    cfg = baseline_config\n    torch.manual_seed(cfg[\"seed\"])\n\n    # A saved checkpoint already contains the model weights.\n    saved = None\n    if baseline_latest.is_file():\n        saved = torch.load(baseline_latest, map_location=\"cpu\", weights_only=True)\n        if saved[\"config\"] != cfg:\n            raise ValueError(\"This checkpoint was created with a different configuration.\")\n\n    model = resnet50(weights=None if saved else ResNet50_Weights.DEFAULT)\n    model.fc = nn.Linear(model.fc.in_features, 1)\n    model = model.to(baseline_device)\n\n    optimizer = torch.optim.AdamW(model.parameters(), lr=cfg[\"learning_rate\"])\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode=\"max\", factor=0.5, patience=1\n    )\n    scaler = torch.amp.GradScaler(\"cuda\", init_scale=1024.0)\n    loss_fn = nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor([cfg[\"pos_weight\"]], device=baseline_device)\n    )\n\n    train_stream = PEImageStream(\"train\", seed=cfg[\"seed\"])\n    validation_stream = PEImageStream(\"validation\")\n    assert len(train_stream) == 963_772\n    assert len(validation_stream) == 122_063\n\n    loader_options = {\n        \"batch_size\": cfg[\"batch_size\"],\n        \"num_workers\": 0,\n        \"pin_memory\": True,\n    }\n    train_loader = DataLoader(train_stream, **loader_options)\n    validation_loader = DataLoader(validation_stream, **loader_options)\n\n    epoch = 1\n    batches_done = 0\n    totals = defaultdict(float)\n    history = []\n    best_ap = -1.0\n    stale_epochs = 0\n\n    if saved is not None:\n        model.load_state_dict(saved[\"model\"])\n        optimizer.load_state_dict(saved[\"optimizer\"])\n        scheduler.load_state_dict(saved[\"scheduler\"])\n        scaler.load_state_dict(saved[\"scaler\"])\n        epoch = saved[\"epoch\"]\n        batches_done = saved[\"batches_done\"]\n        totals.update(saved[\"totals\"])\n        history = saved[\"history\"]\n        best_ap = saved[\"best_ap\"]\n        stale_epochs = saved[\"stale_epochs\"]\n        del saved\n        print(f\"Resuming epoch {epoch} after {batches_done:,} batches.\", flush=True)\n\n    def save_latest():\n        save_baseline_checkpoint({\n            \"config\": cfg,\n            \"model\": model.state_dict(),\n            \"optimizer\": optimizer.state_dict(),\n            \"scheduler\": scheduler.state_dict(),\n            \"scaler\": scaler.state_dict(),\n            \"epoch\": epoch,\n            \"batches_done\": batches_done,\n            \"totals\": dict(totals),\n            \"history\": history,\n            \"best_ap\": best_ap,\n            \"stale_epochs\": stale_epochs,\n        }, baseline_latest)\n\n    last_epoch = min(cfg[\"max_epochs\"], epoch + epochs_this_run - 1)\n\n    while epoch <= last_epoch and stale_epochs < cfg[\"early_stopping_patience\"]:\n        started_at = perf_counter()\n        learning_rate = optimizer.param_groups[0][\"lr\"]\n        train_stream.set_epoch(epoch - 1)\n        torch.manual_seed(cfg[\"seed\"] + epoch)\n        model.train()\n\n        resume_after = batches_done\n        if resume_after:\n            print(f\"Replaying {resume_after:,} batches to reach the checkpoint.\", flush=True)\n\n        for batch_number, (images, labels, _) in enumerate(train_loader, start=1):\n            if batch_number <= resume_after:\n                continue\n\n            images = images.to(baseline_device, non_blocking=True)\n            labels = labels.to(baseline_device, non_blocking=True)\n\n            optimizer.zero_grad(set_to_none=True)\n            with torch.autocast(\"cuda\", dtype=torch.float16):\n                logits = model(images).squeeze(1)\n                loss = loss_fn(logits, labels)\n\n            if not torch.isfinite(loss).item():\n                raise FloatingPointError(f\"Non-finite loss at batch {batch_number}.\")\n\n            scale_before = scaler.get_scale()\n            scaler.scale(loss).backward()\n            scaler.unscale_(optimizer)\n            nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            scaler.step(optimizer)\n            scaler.update()\n\n            totals[\"loss_sum\"] += loss.item() * labels.numel()\n            totals[\"slices\"] += labels.numel()\n            totals[\"updates\"] += int(scaler.get_scale() >= scale_before)\n            batches_done = batch_number\n\n            if batch_number % cfg[\"checkpoint_every\"] == 0:\n                save_latest()\n                print(\n                    f\"Epoch {epoch} | {batch_number:,}/{len(train_loader):,} batches | \"\n                    f\"mean loss={totals['loss_sum'] / totals['slices']:.4f} | saved latest.pt\",\n                    flush=True,\n                )\n\n        assert totals[\"slices\"] == len(train_stream), \"Training slice count is wrong.\"\n        assert totals[\"updates\"] > 0, \"No optimizer updates completed.\"\n        save_latest()\n        print(f\"Epoch {epoch}: training complete. Starting full validation.\", flush=True)\n\n        metrics = validate_baseline(model, validation_loader, loss_fn)\n        validation_ap = metrics[\"validation_ap\"]\n        scheduler.step(validation_ap)\n\n        if validation_ap > best_ap:\n            best_ap = validation_ap\n            stale_epochs = 0\n            save_baseline_checkpoint({\n                \"config\": cfg,\n                \"model\": model.state_dict(),\n                \"epoch\": epoch,\n                **metrics,\n            }, baseline_best)\n        else:\n            stale_epochs += 1\n\n        history.append({\n            \"epoch\": epoch,\n            \"learning_rate\": learning_rate,\n            \"train_slices\": int(totals[\"slices\"]),\n            \"successful_updates\": int(totals[\"updates\"]),\n            \"train_loss\": totals[\"loss_sum\"] / totals[\"slices\"],\n            **metrics,\n        })\n        pd.DataFrame(history).to_csv(baseline_history, index=False)\n\n        print(\n            f\"Epoch {epoch} | validation AP={validation_ap:.4f} | \"\n            f\"ROC-AUC={metrics['validation_roc_auc']:.4f} | \"\n            f\"{(perf_counter() - started_at) / 60:.1f} min in this run\",\n            flush=True,\n        )\n\n        epoch += 1\n        batches_done = 0\n        totals.clear()\n        save_latest()\n\n    if stale_epochs >= cfg[\"early_stopping_patience\"]:\n        print(\"Early stopping triggered.\")\n    if epoch > cfg[\"max_epochs\"]:\n        print(\"Reached the maximum number of epochs.\")\n\n    if history:\n        print(\"\\n=== Stage 10 baseline history ===\")\n        print(pd.DataFrame(history).round(4).to_string(index=False))\n\n    for path in (baseline_latest, baseline_best, baseline_history):\n        if path.is_file():\n            print(f\"Saved: {path} ({path.stat().st_size / 1024**2:.2f} MiB)\")\n\n\nprint(f\"Stage 10 setup passed. Outputs will go to {baseline_dir}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-20T11:27:18.58822Z","iopub.execute_input":"2026-11-20T11:27:18.589073Z","iopub.status.idle":"2026-11-20T11:27:18.618448Z","shell.execute_reply.started":"2026-11-20T11:27:18.589045Z","shell.execute_reply":"2026-11-20T11:27:18.617839Z"}},"outputs":[{"name":"stdout","text":"Stage 10 setup passed. Outputs will go to /kaggle/working/resnet50_baseline\n","output_type":"stream"}],"execution_count":34},{"cell_type":"markdown","source":"## Stage 10B — Run one full epoch\n\nTrain on the complete training split and evaluate the complete\nvalidation split. Save progress during training and keep the\ncheckpoint with the highest validation average precision.\n\nExpected output: Progress every 2,000 batches, followed by\nvalidation metrics and the saved output paths.","metadata":{}},{"cell_type":"code","source":"run_resnet50_baseline(epochs_this_run=1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-20T11:28:19.329686Z","iopub.execute_input":"2026-11-20T11:28:19.329977Z"}},"outputs":[{"name":"stdout","text":"Epoch 1 | 2,000/60,236 batches | mean loss=1.0002 | saved latest.pt\nEpoch 1 | 4,000/60,236 batches | mean loss=0.9274 | saved latest.pt\nEpoch 1 | 6,000/60,236 batches | mean loss=0.9269 | saved latest.pt\n","output_type":"stream"}],"execution_count":null}]}