"image\" in field_bytes:\n                    try:\n                        with Image.open(io.BytesIO(field_bytes[\"image\"])) as image:\n                            if image.format != \"JPEG\":\n                                raise ValueError(f\"Unexpected format: {image.format}\")\n                            image.load()\n                            image_shapes[(image.width, image.height, image.mode)] += 1\n                            valid_jpeg_count += 1\n\n                            if target_values is not None and image_id is not None and not is_duplicate:\n                                image_label = int(target_values[0])\n                                if len(preview_images[image_label]) < 5:\n                                    preview_images[image_label].append(\n                                        (image_id, image.copy(), target_values.copy())\n                                    )\n                    except (OSError, ValueError, Image.DecompressionBombError) as error:\n                        record_issue(\"JPEG decode error\", path.name, records_in_file, str(error))\n\n        except tf.errors.OpError as error:\n            scan_status = \"stopped early\"\n            record_issue(\"TFRecord read error\", path.name, records_in_file + 1, str(error))\n\n        record_counts[path.name] = records_in_file\n        minutes = (perf_counter() - started_at) / 60\n        print(\n            f\"[{file_number:02d}/{len(tfrecord_files)}] {path.name}: \"\n            f\"{records_in_file:,} records | {scan_status} | {minutes:.1f} min elapsed\",\n            flush=True,\n        )\n\nprint(\"\\n=== Stage 3 scan summary ===\")\nprint(f\"Records read: {sum(record_counts.values()):,}\")\nprint(f\"Files that stopped early: {issues['TFRecord read error']}\")\nprint(f\"Valid JPEGs: {valid_jpeg_count:,}\")\nprint(f\"Valid targets: {valid_target_count:,}\")\nprint(f\"Unique image IDs: {len(seen_image_ids):,}\")\nprint(f\"Repeated image ID occurrences: {issues['re