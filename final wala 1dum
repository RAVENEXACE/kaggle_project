enchmark_device, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n        with torch.autocast(device_type=\"cuda\", dtype=torch.float16):\n            logits = model(batch_images).squeeze(1)\n            loss = loss_fn(logits, batch_labels)\n\n        if not torch.isfinite(loss).item():\n            raise FloatingPointError(f\"Non-finite loss at step {step + 1}.\")\n\n        scale_before = scaler.get_scale()\n        scaler.scale(loss).backward()\n        scaler.unscale_(optimizer)\n        nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        scaler.step(optimizer)\n        scaler.update()\n\n        if step >= benchmark_warmup_steps:\n            timed_updates += int(scaler.get_scale() >= scale_before)\n            timed_images += batch_images.size(0)\n\n    torch.cuda.synchronize(benchmark_device)\n    seconds = perf_counter() - started_at\n    images_per_second = timed_images / seconds\n    gib = 1024 ** 3\n\n    return {\n        \"size\": resolution,\n        \"batch\": batch_size,\n        \"status\": \"ok\" if timed_updates == benchmark_timed_steps else \"skipped updates\",\n        \"updates\": f\"{timed_updates}/{benchmark_timed_steps}\",\n        \"images_per_sec\": round(images_per_second, 1),\n        \"peak_reserved_GiB\": round(\n            torch.cuda.max_memory_reserved(benchmark_device) / gib, 2\n        ),\n        \"est_train_hours\": round(len(train_stream) / images_per_second / 3600, 2),\n    }\n\n\nbenchmark_train_stream = PEImageStream(\"train\")\nbenchmark_results = []\n\nfor resolution, batch_size in benchmark_settings:\n    print(f\"Testing {resolution} × {resolution}, batch {batch_size}...\", flush=True)\n    try:\n        result = benchmark_resnet50(resolution, batch_size, benchmark_train_stream)\n    except torch.OutOfMemoryError:\n        result = {\n            \"size\": resolution,\n            \"batch\": batch_size,\n            \"status\": \"GPU out of memory\",\n        }\n    except FloatingPoin