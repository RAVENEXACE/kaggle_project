ss).item():\n            raise FloatingPointError(\"Non-finite validation loss.\")\n\n        loss_sum += loss.item() * labels.numel()\n        scores.append(logits.cpu().numpy())\n        targets.append(labels.cpu().numpy())\n\n    scores = np.concatenate(scores)\n    targets = np.concatenate(targets)\n    assert len(targets) == 122_063 and int(targets.sum()) == 6_023\n\n    return {\n        \"validation_loss\": loss_sum / len(targets),\n        \"validation_ap\": float(average_precision_score(targets, scores)),\n        \"validation_roc_auc\": float(roc_auc_score(targets, scores)),\n    }\n\n\ndef run_resnet50_baseline(epochs_this_run=1):\n    assert epochs_this_run >= 1\n    cfg = baseline_config\n    torch.manual_seed(cfg[\"seed\"])\n\n    # A saved checkpoint already contains the model weights.\n    saved = None\n    if baseline_latest.is_file():\n        saved = torch.load(baseline_latest, map_location=\"cpu\", weights_only=True)\n        if saved[\"config\"] != cfg:\n            raise ValueError(\"This checkpoint was created with a different configuration.\")\n\n    model = resnet50(weights=None if saved else ResNet50_Weights.DEFAULT)\n    model.fc = nn.Linear(model.fc.in_features, 1)\n    model = model.to(baseline_device)\n\n    optimizer = torch.optim.AdamW(model.parameters(), lr=cfg[\"learning_rate\"])\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode=\"max\", factor=0.5, patience=1\n    )\n    scaler = torch.amp.GradScaler(\"cuda\", init_scale=1024.0)\n    loss_fn = nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor([cfg[\"pos_weight\"]], device=baseline_device)\n    )\n\n    train_stream = PEImageStream(\"train\", seed=cfg[\"seed\"])\n    validation_stream = PEImageStream(\"validation\")\n    assert len(train_stream) == 963_772\n    assert len(validation_stream) == 122_063\n\n    loader_options = {\n        \"batch_size\": cfg[\"batch_size\"],\n        \"num_workers\": 0,\n        \"pin_memory\": True,\n    }\n   