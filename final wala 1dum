e,\n    confusion_matrix,\n    precision_recall_curve,\n    roc_auc_score,\n)\nfrom torch import nn\nfrom torch.utils.data import DataLoader\nfrom torchvision.models import resnet50\n\ncheckpoint_path = Path(\"/kaggle/working/resnet50_baseline/best.pt\")\nassert checkpoint_path.is_file(), \"Restore best.pt from the epoch 1 backup first.\"\nassert torch.cuda.is_available(), \"Enable a GPU in Kaggle settings.\"\n\ndevice = torch.device(\"cuda:0\")\ncheckpoint = torch.load(checkpoint_path, map_location=\"cpu\", weights_only=True)\nassert checkpoint[\"epoch\"] == 1, f\"Expected epoch 1, found {checkpoint['epoch']}.\"\nassert checkpoint[\"config\"][\"image_size\"] == image_size\n\nmodel = resnet50(weights=None)\nmodel.fc = nn.Linear(model.fc.in_features, 1)\nmodel.load_state_dict(checkpoint[\"model\"])\nmodel = model.to(device).eval()\n\nvalidation_loader = DataLoader(\n    PEImageStream(\"validation\"),\n    batch_size=16,\n    num_workers=0,\n    pin_memory=True,\n)\n\nall_scores = []\nall_labels = []\nall_image_ids = []\n\nprint(\"Scoring validation slices with the epoch 1 checkpoint...\", flush=True)\n\nwith torch.inference_mode():\n    for batch_number, (images, labels, image_ids) in enumerate(validation_loader, 1):\n        images = images.to(device, non_blocking=True)\n\n        with torch.autocast(\"cuda\", dtype=torch.float16):\n            logits = model(images).squeeze(1)\n\n        scores = logits.float().sigmoid().cpu().numpy()\n        all_scores.append(scores)\n        all_labels.append(labels.numpy())\n        all_image_ids.extend(image_ids)\n\n        if batch_number % 500 == 0:\n            print(f\"Validation batches: {batch_number:,}/{len(validation_loader):,}\",\n                  flush=True)\n\nscores = np.concatenate(all_scores)\nlabels = np.concatenate(all_labels).astype(int)\n\nassert len(scores) == len(labels) == len(all_image_ids) == 122_063\nassert len(set(all_image_ids)) == len(all_image_ids)\nassert labels.sum() == 6_023\nassert np.isfinite(scores).all()\n\nprecision, recall, thresholds = precision_recall_curve(labels, scores)\n\n# The curve includes one extra precision/recall point with no threshold.\nprecision = precision[:-1]\nrecall = recall[:-1]\ndenominator = precision + recall\nf1 = np.divide(\n    2 * precision * recall,\n    denominator,\n    out=np.zeros_like(denominator),\n    where=denominator > 0,\n)\n\n# If several thresholds tie, use the highest one.\nbest_index = np.flatnonzero(f1 == f1.max())[-1]\nthreshold = float(thresholds[best_index])\npredictions = (scores >= threshold).astype(int)\ntn, fp, fn, tp = confusion_matrix(labels, predictions, labels=[0, 1]).ravel()\n\nresults = {\n    \"model\": \"resnet50\",\n    \"checkpoint_epoch\": int(checkpoint[\"epoch\"]),\n    \"selection_split\": \"validation\",\n    \"selection_metric\": \"maximum F1\",\n    \"score_type\": \"sigmoid of model logit\",\n    \"threshold\": threshold,\n    \"validation_ap\": float(average_precision_score(labels, scores)),\n    \"validation_roc_auc\": float(roc_auc_score(labels, scores)),\n    \"validation_f1\": float(f1[best_index]),\n    \"validation_precision\": float(precision[best_index]),\n    \"validation_sensitivity\": float(recall[best_index]),\n    \"validation_specificity\": float(tn / (tn + fp)),\n    \"confusion_matrix\": {\"tn\": int(tn), \"fp\": int(fp), \"fn\": int(fn), \"tp\": int(tp)},\n}\n\noutput_dir = Path(\"/kaggle/working/resnet50_validation\")\noutput_dir.mkdir(parents=True, exist_ok=True)\n\nscores_path = output_dir / \"validation_predictions.csv.gz\"\nthreshold_path = output_dir / \"decision_threshold.json\"\n\npd.DataFrame({\n    \"image_name\": all_image_ids,\n    \"pe_present_on_image\": labels,\n    \"score\": scores,\n    \"prediction\": predictions,\n}).to_csv(scores_path, index=False)\n\nthreshold_path.write_text(json.dumps(results, indent=2) + \"\\n\", encoding=\"utf-8\")\n\nprint(\"\\n=== Stage 11 validation results ===\")\nprint(json.dumps(results, indent=2))\nprint(f\"Saved: {s