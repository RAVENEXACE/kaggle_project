Error:\n    print(\"TensorFlow devices are already initialized. Reading records on the CPU.\")\n\nsample_files = [\n    tfrecord_files[0],\n    tfrecord_files[len(tfrecord_files) // 2],\n    tfrecord_files[-1],\n]\n\nexpected_fields = {\"image\", \"image_name\", \"target\"}\nrecords_checked = 0\njpeg_count = 0\n\nwith tf.device(\"/CPU:0\"):\n    for record_path in sample_files:\n        print(f\"\\n=== {record_path.name} ===\")\n        dataset = tf.data.TFRecordDataset(str(record_path))\n\n        for record_number, record in enumerate(dataset.take(3), start=1):\n            records_checked += 1\n            example = tf.train.Example.FromString(record.numpy())\n            features = example.features.feature\n\n            print(f\"\\nRecord {record_number}\")\n            for name, feature in sorted(features.items()):\n                kind = feature.WhichOneof(\"kind\")\n                count = len(getattr(feature, kind).value) if kind else 0\n                print(f\"  {name}: {kind}, {count} value(s)\")\n\n            missing_fields = expected_fields.difference(features.keys())\n            if missing_fields:\n                print(\"  Missing fields:\", sorted(missing_fields))\n                continue\n\n            image_values = features[\"image\"].bytes_list.value\n            name_values = features[\"image_name\"].bytes_list.value\n\n            if len(image_values) != 1 or len(name_values) != 1:\n                print(\"  Expected one image and one image identifier as bytes.\")\n                continue\n\n            image_id = name_values[0].decode(\"utf-8\", errors=\"replace\")\n            print(f\"  Image ID: {image_id}\")\n\n            try:\n                with Image.open(io.BytesIO(image_values[0])) as img:\n                    img.load()\n                    print(f\"  Image: {img.format}, {img.width} × {img.height}, mode={img.mode}\")\n                    jpeg_count += int(img.format == \"JPEG\")\n            except (OSError, ValueError) as er