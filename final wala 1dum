d_id:\n                        raise ValueError(\n                            f\"Manifest mismatch in {shard}, record {number}. \"\n                            f\"Expected {expected_id}, found {image_id}.\"\n                        )\n\n                    jpeg = features[\"image\"].bytes_list.value[0]\n                    records_found += 1\n                    yield jpeg, label, image_id\n\n            if records_found != len(selected):\n                raise ValueError(\n                    f\"{shard}: read {records_found} of {len(selected)} expected records.\"\n                )\n\n    def _shuffle_records(self, records, rng):\n        # Shuffle compressed JPEGs in a small buffer to limit RAM use.\n        buffer = []\n        for record in records:\n            if len(buffer) < self.shuffle_buffer:\n                buffer.append(record)\n                continue\n\n            index = rng.randrange(len(buffer))\n            selected = buffer[index]\n            buffer[index] = record\n            yield selected\n\n        rng.shuffle(buffer)\n        yield from buffer\n\n    def __iter__(self):\n        if torch.utils.data.get_worker_info() is not None:\n            raise RuntimeError(\"Use num_workers=0 with this TensorFlow-backed loader.\")\n\n        rng = random.Random(self.seed + self.epoch)\n        records = self._records(rng)\n        if self.split == \"train\":\n            records = self._shuffle_records(records, rng)\n\n        for jpeg, label, image_id in records:\n            try:\n                with Image.open(io.BytesIO(jpeg)) as image:\n                    if image.format != \"JPEG\":\n                        raise ValueError(f\"Expected JPEG, got {image.format}.\")\n                    image_tensor = self.transform(image.convert(\"RGB\"))\n            except (OSError, ValueError) as error:\n                raise RuntimeError(f\"Could not decode or preprocess {image_id}.\") from error\n\n            yield image_tensor, torch.tensor(label, dtyp