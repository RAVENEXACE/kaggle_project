50(weights=None)\ncam_model.fc = nn.Linear(cam_model.fc.in_features, 1)\ncam_model.load_state_dict(cam_checkpoint[\"model\"])\ncam_model = cam_model.to(cam_device).eval()\ndel cam_checkpoint\n\n# Find the four selected images in the test manifest.\nselected_rows = loader_manifest.loc[\n    loader_manifest[\"split\"].eq(\"test\")\n    & loader_manifest[\"image_name\"].isin(cam_examples[\"image_name\"])\n]\nassert len(selected_rows) == 4, \"Expected four selected test images.\"\n\ncam_stream = PEImageStream(\"test\")\ncam_stream.rows_by_shard = {\n    shard: {\n        record_number: (image_id, label)\n        for record_number, image_id, label in rows[\n            [\"record_number\", \"image_name\", \"pe_present_on_image\"]\n        ].itertuples(index=False, name=None)\n    }\n    for shard, rows in selected_rows.groupby(\"tfrecord_file\", sort=True)\n}\ncam_stream.sample_count = len(selected_rows)\n\n\ndef make_pe_gradcam(model, image_tensor, device):\n    activation = None\n\n    def capture_activation(_module, _inputs, output):\n        nonlocal activation\n        activation = output\n\n    hook = model.layer4[-1].register_forward_hook(capture_activation)\n    try:\n        with torch.enable_grad():\n            image_batch = image_tensor.unsqueeze(0).to(device)\n            pe_logit = model(image_batch)[0, 0]\n            assert activation is not None, \"The Grad-CAM layer did not run.\"\n            gradient = torch.autograd.grad(pe_logit, activation)[0]\n\n        channel_weights = gradient.mean(dim=(2, 3), keepdim=True)\n        heatmap = (channel_weights * activation.detach()).sum(dim=1, keepdim=True)\n        heatmap = F.interpolate(\n            heatmap.relu(),\n            size=image_tensor.shape[-2:],\n            mode=\"bilinear\",\n            align_corners=False,\n        )[0, 0]\n        assert torch.isfinite(heatmap).all(), \"Non-finite Grad-CAM values.\"\n\n        minimum = heatmap.min()\n        spread = heatmap.max() - minimum\n        normalized = (heatmap - minimum) / spread.clamp_min(1e-12)\n        return normalized.cpu().numpy(), spread.item()\n    finally:\n        hook.remove()\n\n\ncam_images = {}\nfor image_tensor, label, image_id in cam_stream:\n    cam_images[image_id] = (image_tensor, int(label.item()))\n    print(f\"Loaded {len(cam_images)}/4: {image_id}\", flush=True)\n\nassert set(cam_images) == set(cam_examples[\"image_name\"])\n\n# Undo the loader's normalization for display.\ndisplay_mean = torch.tensor(rgb_mean).view(3, 1, 1)\ndisplay_std = torch.tensor(rgb_std).view(3, 1, 1)\n\nfigure, axes = plt.subplots(4, 2, figsize=(8, 15))\naxes[0, 0].set_title(\"Original image\")\naxes[0, 1].set_title(\"Grad-CAM overlay\")\ncam_spreads = []\n\nfor row, example in enumerate(cam_examples.itertuples(index=False)):\n    image_tensor, label = cam_images[example.image_name]\n    assert label == example.true_label, f\"Label mismatch for {example.image_name}.\"\n\n    heatmap, spread = make_pe_gradcam(cam_model, image_tensor, cam_device)\n    cam_spreads.append(spread)\n\n    rgb = (image_tensor * display_std + display_mean).clamp(0, 1)\n    rgb = rgb.permute(1, 2, 0).numpy()\n\n    # Blend the heatmap and CT into a single RGB image.\n    heatmap_rgb = plt.get_cmap(\"inferno\")(heatmap)[..., :3]\n    opacity = 0.55 * heatmap[..., None]\n    overlay = np.clip(rgb * (1 - opacity) + heatmap_rgb * opacity, 0, 1)\n\n    axes[row, 0].imshow(rgb)\n    axes[row, 1].imshow(overlay)\n\n    axes[row, 0].set_xlabel(\n        f\"{example.outcome} | {example.image_name}\\n\"\n        f\"True: {example.true_label} | Predicted: {example.predicted_label}\"\n    )\n\n    overlay_note = \"\\nFlat heatmap\" if spread <= 1e-12 else \"\"\n    axes[row, 1].set_xlabel(\n        f\"Saved test score: {example.test_score:.6f}{overlay_note}\"\n    )\n\n    for axis in axes[row]:\n        axis.set_xticks([])\n        axis.set_yticks([])\n\ncam_output_dir = Path(\"/kaggle/working/resnet50_gradcam\")\ncam_output_dir.mkdir(parents=True