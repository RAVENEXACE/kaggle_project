upby(\"StudyInstanceUID\", sort=True)\n\nassert by_exam[exam_status_columns].nunique().le(1).all().all(), (\n    \"Some slices disagree on the status of their exam.\"\n)\n\nexam_table = by_exam[exam_status_columns].first()\nnegative = exam_table[\"negative_exam_for_pe\"].eq(1)\nindeterminate = exam_table[\"indeterminate\"].eq(1)\nassert not (negative & indeterminate).any(), \"An exam has both status flags.\"\n\nexam_table[\"exam_status\"] = np.select(\n    [indeterminate, negative],\n    [\"indeterminate\", \"negative\"],\n    default=\"PE-positive\",\n)\n\n# Reserve 20% of exams, then divide that group evenly.\ntrain_exams, reserved_exams = train_test_split(\n    exam_table,\n    test_size=0.20,\n    random_state=split_seed,\n    stratify=exam_table[\"exam_status\"],\n)\n\nvalidation_exams, test_exams = train_test_split(\n    reserved_exams,\n    test_size=0.50,\n    random_state=split_seed,\n    stratify=reserved_exams[\"exam_status\"],\n)\n\nsplit_names = [\"train\", \"validation\", \"test\"]\nsplit_tables = [train_exams, validation_exams, test_exams]\nexam_splits = pd.concat(\n    [table.assign(split=name) for name, table in zip(split_names, split_tables)]\n).sort_index()\n\nassert exam_splits.index.is_unique, \"An exam appears in more than one split.\"\nassert exam_splits.index.equals(exam_table.index), \"Some exams are missing.\"\n\nmanifest[\"split\"] = manifest[\"StudyInstanceUID\"].map(exam_splits[\"split\"])\nassert manifest[\"split\"].notna().all(), \"Some images have no split.\"\nassert manifest[\"image_name\"].is_unique, \"Some image IDs are repeated.\"\nassert len(manifest) == len(first_by_id), \"The manifest lost some images.\"\n\nsplit_summary = (\n    manifest.groupby(\"split\")\n    .agg(\n        exams=(\"StudyInstanceUID\", \"nunique\"),\n        slices=(\"image_name\", \"size\"),\n        positive_slices=(\"pe_present_on_image\", \"sum\"),\n    )\n    .reindex(split_names)\n)\nassert split_summary[\"exams\"].sum() == len(exam_table), \"Exam over