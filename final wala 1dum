aggle/input/datasets/stanleyjzheng/rsna-str-tfrec\")\n\nassert backup.is_dir(), f\"Attach the Backup dataset. Expected: {backup}\"\nassert records_dir.is_dir(), f\"Attach the TFRecord dataset. Expected: {records_dir}\"\n\n# Use the same correctly classified examples from the report.\n# Each pair contains the image ID and its verified slice-level label.\nexamples = [\n    (\"0013_8a24c1069985\", 0),\n    (\"0098_e4d9f6668c41\", 1),\n]\nexample_ids = {image_id for image_id, _ in examples}\n\n# Find the original manifest and the selected model.\nmanifest_columns = [\n    \"image_name\", \"tfrecord_file\", \"record_number\", \"pe_present_on_image\", \"split\"\n]\nmanifest_files = sorted(backup.rglob(\"image_split_manifest.csv.gz\"))\nif not manifest_files:\n    manifest_files = sorted(backup.rglob(\"image_split_manifest.csv\"))\n\ncheckpoint_files = sorted(backup.rglob(\"resnet50_baseline/best.pt\"))\nrestore_zip = backup / \"resnet50_epoch1_backup.zip\"\n\nif len(manifest_files) == 1:\n    manifest = pd.read_csv(manifest_files[0], usecols=manifest_columns)\nelif not manifest_files and restore_zip.is_file():\n    with ZipFile(restore_zip) as archive:\n        with archive.open(\"pe_splits/image_split_manifest.csv.gz\") as source:\n            manifest = pd.read_csv(source, compression=\"gzip\", usecols=manifest_columns)\nelse:\n    raise FileNotFoundError(f\"Expected a single split manifest. Found: {manifest_files}\")\n\nif len(checkpoint_files) == 1:\n    checkpoint = torch.load(checkpoint_files[0], map_location=\"cpu\", weights_only=True)\nelif not checkpoint_files and restore_zip.is_file():\n    with ZipFile(restore_zip) as archive:\n        model_bytes = archive.read(\"resnet50_baseline/best.pt\")\n    checkpoint = torch.load(io.BytesIO(model_bytes), map_location=\"cpu\", weights_only=True)\n    del model_bytes\nelse:\n    raise FileNotFoundError(f\"Expected one ResNet50 best.pt. Found: {checkpoint_files}\")\n\nassert checkpoint[\"epoch\"] == 1, \"Use the selected epoch 1 ResNet50 checkpoint.\"\nassert checkpoint[\"config\"][\"image_size\"] == 384\n\nselected = manifest.loc[\n    manifest[\"split\"].eq(\"test\") & manifest[\"image_name\"].isin(example_ids)\n].copy()\nassert len(selected) == 2 and set(selected[\"image_name\"]) == example_ids\ndel manifest\n\n# Read only as far as necessary in the TFRecord files containing these two slices.\ntry:\n    tf.config.set_visible_devices([], \"GPU\")\nexcept RuntimeError:\n    pass\n\ndisplay_images = {}\n\nwith tf.device(\"/CPU:0\"):\n    for shard, rows in selected.groupby(\"tfrecord_file\"):\n        wanted = {int(row.record_number): row for row in rows.itertuples()}\n        shard_path = records_dir / shard\n        assert shard_path.is_file(), f\"Missing TFRecord: {shard_path}\"\n        print(f\"Finding demo slices in {shard}...\", flush=True)\n\n        records = tf.data.TFRecordDataset(str(shard_path)).take(max(wanted))\n        for number, raw in enumerate(records.as_numpy_iterator(), start=1):\n            row = wanted.get(number)\n            if row is None:\n                continue\n\n            features = tf.train.Example.FromString(raw).features.feature\n            image_id = features[\"image_name\"].bytes_list.value[0].decode(\"utf-8\")\n            assert image_id == row.image_name, f\"Manifest mismatch at record {number}\"\n\n            jpeg = features[\"image\"].bytes_list.value[0]\n            with Image.open(io.BytesIO(jpeg)) as image:\n                display_images[image_id] = image.convert(\"RGB\")\n\nassert set(display_images) == example_ids\n\n# Reuse the same preprocessing and fixed threshold as the test run.\npreprocess = transforms.Compose([\n    transforms.Resize((384, 384), interpolation=transforms.InterpolationMode.BILINEAR),\n    transforms.ToTensor(),\n    transforms.Normalize(\n        mean=(0.485, 0.456, 0.406),\n        std=(0.229, 0.224, 0.225),\n    ),\n])\nthreshold = 0.02437659725546837\n\ndevice = torch.device(\"cuda:0\" if torch.cuda.is_available() else \"cpu\")\nmodel = resnet50(weights=None)\nmodel.fc = nn.Linear(model.fc.in_features, 1)\nmodel.load_state_dict(checkpoint[\"model\"])\nmodel = model.to(device).eval()\ndel checkpoint\n\nbatch = torch.stack([preprocess(display_images[image_id]) for image_id, _ in examples])\nwith torch.inference_mode():\n    with torch.autocast(\"cuda\", dtype=torch.float16, enabled=device.type == \"cuda\"):\n        logits = model(batch.to(device)).squeeze(1)\n    scores = logits.float().sigmoid().cpu().numpy()\n\nout = Path(\"/kaggle/working/viva_demo\")\nout.mkdir(parents=True, exist_ok=True)\n\ndef label_name(label):\n    return \"PE-positive\" if label else \"PE-negative\"\n\nfig, axes = plt.subplots(1, 2, figsize=(10, 5.4), layout=\"constrained\")\nfig.suptitle(\"ResNet50 viva demo · Two held-out CTPA slices\", fontsize=15)\n\nfor ax, (image_id, expected_label), score in zip(axes, examples, scores):\n    manifest_label = int(selected.loc[\n        selected[\"image_name\"].eq(image_id), \"pe_present_on_image\"\n    ].iloc[0])\n    assert manifest_label == expected_label\n    prediction = int(score >= threshold)\n\n    ax.imshow(display_images[image_id])\n    ax.set_title(\n        f\"Reference: {label_name(expected_label)}\\n\"\n        f\"Model: {label_name(prediction)} · Score: {score:.6f}\",\n        fontsize=11,\n    )\n    ax.set_xlabel(image_id)\n    ax.set_xticks([])\n    ax.set_yticks([])\n\nfig.savefig(out / \"01_CT_comparison.png\", dpi=170, bbox_inches=\"tight\")\nplt.show()\nplt.close(fig)\n\n# These are the recorded results from the completed full test run.\ntn, fp, fn, tp = 94_956, 21_104, 3_528, 2_715\ntotal = tn + fp + fn + tp\n\nmetrics = {\n    \"Accuracy\": (tp + tn) / total,\n    \"Precision\": tp / (tp + fp),\n    \"Sensitivity / recall\": tp / (tp + fn),\n    \"Specificity\": tn / (tn + fp),\n    \"F1\": 2 * tp / (2 * tp + fp + fn),\n}\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 4.8), layout=\"constrained\")\nfig.suptitle(f\"Recorded held-o