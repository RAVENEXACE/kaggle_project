 as pd\nimport tensorflow as tf\nimport torch\nfrom PIL import Image\nfrom torch.utils.data import DataLoader, IterableDataset\nfrom torchvision import transforms\nfrom torchvision.transforms import InterpolationMode\n\nimage_size = 384\nloader_seed = 42\n\nmanifest_path = Path(\"/kaggle/working/pe_splits/image_split_manifest.csv.gz\")\nloader_columns = [\n    \"tfrecord_file\", \"record_number\", \"image_name\", \"pe_present_on_image\", \"split\"\n]\nloader_manifest = pd.read_csv(manifest_path, usecols=loader_columns)\n\npaths_by_name = {path.name: path for path in tfrecord_files}\nmissing_shards = set(loader_manifest[\"tfrecord_file\"]) - paths_by_name.keys()\nassert not missing_shards, f\"Missing TFRecord files: {sorted(missing_shards)}\"\nassert not loader_manifest.duplicated([\"tfrecord_file\", \"record_number\"]).any()\nassert loader_manifest[\"pe_present_on_image\"].isin([0, 1]).all()\n\n# Use the normalization commonly expected by ImageNet-pretrained encoders.\nrgb_mean = (0.485, 0.456, 0.406)\nrgb_std = (0.229, 0.224, 0.225)\n\nresize_image = transforms.Resize(\n    (image_size, image_size), interpolation=InterpolationMode.BILINEAR\n)\nnormalize_image = transforms.Normalize(rgb_mean, rgb_std)\n\ntrain_transform = transforms.Compose([\n    resize_image,\n    transforms.RandomAffine(\n        degrees=5,\n        translate=(0.02, 0.02),\n        interpolation=InterpolationMode.BILINEAR,\n        fill=0,\n    ),\n    transforms.ColorJitter(brightness=0.08, contrast=0.08),\n    transforms.ToTensor(),\n    normalize_image,\n])\n\neval_transform = transforms.Compose([\n    resize_image,\n    transforms.ToTensor(),\n    normalize_image,\n])\n\n\nclass PEImageStream(IterableDataset):\n    def __init__(self, split, seed=loader_seed, shuffle_buffer=512):\n        super().__init__()\n        if split not in {\"train\", \"validation\", \"test\"}:\n            raise ValueError(f\"Unknown split: {split}\")\n        if shuffle_buffer < 1:\n            raise ValueError(\"sh