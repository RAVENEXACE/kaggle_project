sage import DecodeError\nfrom PIL import Image\n\nlabel_names = [\n    \"pe_present_on_image\",\n    \"negative_exam_for_pe\",\n    \"indeterminate\",\n    \"chronic_pe\",\n    \"acute_and_chronic_pe\",\n    \"central_pe\",\n    \"leftsided_pe\",\n    \"rightsided_pe\",\n    \"rv_lv_ratio_gte_1\",\n    \"rv_lv_ratio_lt_1\",\n]\n\nrequired_fields = (\"image\", \"image_name\", \"target\")\nrecord_counts = {}\nimage_shapes = Counter()\nissues = Counter()\nissue_examples = []\nseen_image_ids = set()\nlabel_ones = np.zeros(len(label_names), dtype=np.int64)\nvalid_target_count = 0\nvalid_jpeg_count = 0\npreview_images = {0: [], 1: []}\n\ndef record_issue(problem, filename, record_number, detail=\"\"):\n    issues[problem] += 1\n    if len(issue_examples) < 10:\n        issue_examples.append((problem, filename, record_number, detail))\n\nstarted_at = perf_counter()\n\nwith tf.device(\"/CPU:0\"):\n    for file_number, path in enumerate(tfrecord_files, start=1):\n        records_in_file = 0\n        scan_status = \"complete\"\n\n        try:\n            for raw_record in tf.data.TFRecordDataset(str(path)):\n                records_in_file += 1\n\n                try:\n                    example = tf.train.Example.FromString(raw_record.numpy())\n                except DecodeError:\n                    record_issue(\"invalid Example\", path.name, records_in_file)\n                    continue\n\n                features = example.features.feature\n                field_bytes = {}\n\n                for name in required_fields:\n                    if name not in features:\n                        record_issue(f\"missing {name}\", path.name, records_in_file)\n                        continue\n\n                    feature = features[name]\n                    values = feature.bytes_list.value\n                    if feature.WhichOneof(\"kind\") != \"bytes_list\" or len(values) != 1:\n                        record_issue(f\"invalid {name} field\", path.name, records_in_file)\n                        continue\n\n                    field_bytes[name] = values[0]\n\n                image_id = None\n                is_duplicate = False\n                if \"image_name\" in field_bytes:\n                    try:\n                        image_id = field_bytes[\"image_name\"].decode(\"utf-8\")\n                        if not image_id.strip():\n                            raise ValueError(\"Empty image ID\")\n                    except ValueError:\n                        image_id = None\n                        record_issue(\"invalid image ID\", path.name, records_in_file)\n                    else:\n                        is_duplicate = image_id in seen_image_ids\n                        if is_duplicate:\n                            record_issue(\n                                \"repeated image ID\", path.name, records_in_file, image_id\n                            )\n                        seen_image_ids.add(image_id)\n\n                target_values = None\n                if \"target\" in field_bytes:\n                    try:\n                        tensor_proto = TensorProto.FromString(field_bytes[\"target\"])\n                        values = tf.make_ndarray(tensor_proto)\n                        if values.shape != (10,) or values.dtype != np.uint8:\n                            raise ValueError(f\"shape={values.shape}, dtype={values.dtype}\")\n                        if not np.all((values == 0) | (values == 1)):\n                            raise ValueError(\"Target contains values other than 0 and 1\")\n                    except (DecodeError, ValueError, TypeError, KeyError, OverflowError) as error:\n                        record_issue(\"invalid target\", path.name, records_in_file, str(error))\n                    else:\n                        target_values = values\n                        label_ones += values\n                        valid_target_count += 1\n\n                if \"image\" in field_bytes:\n                    