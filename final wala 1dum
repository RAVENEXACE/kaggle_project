n    \"seed\": 42,\n    \"learning_rate\": 1e-4,\n    \"pos_weight\": dense_negative / dense_positive,\n    \"checkpoint_every\": 2000,\n}\n\n\ndef save_dense_checkpoint(payload, path):\n    temporary_path = path.with_suffix(\".tmp\")\n    torch.save(payload, temporary_path)\n    temporary_path.replace(path)\n\n\n@torch.inference_mode()\ndef validate_densenet121(model, loader, loss_fn):\n    model.eval()\n    loss_sum = 0.0\n    score_batches = []\n    label_batches = []\n\n    for batch_number, (images, labels, _) in enumerate(loader, start=1):\n        images = images.to(dense_device, non_blocking=True)\n        labels = labels.to(dense_device, non_blocking=True)\n\n        with torch.autocast(\"cuda\", dtype=torch.float16):\n            logits = model(images).squeeze(1)\n\n        logits = logits.float()\n        loss = loss_fn(logits, labels)\n        if not torch.isfinite(loss).item():\n            raise FloatingPointError(f\"Non-finite validation loss at batch {batch_number}.\")\n\n        loss_sum += loss.item() * labels.numel()\n        score_batches.append(logits.cpu().numpy())\n        label_batches.append(labels.cpu().numpy())\n\n        if batch_number % 500 == 0:\n            print(f\"Validation: {batch_number:,}/{len(loader):,} batches\", flush=True)\n\n    scores = np.concatenate(score_batches)\n    targets = np.concatenate(label_batches)\n    assert len(targets) == 122_063 and int(targets.sum()) == 6_023\n\n    return {\n        \"validation_loss\": loss_sum / len(targets),\n        \"validation_ap\": float(average_precision_score(targets, scores)),\n        \"validation_roc_auc\": float(roc_auc_score(targets, scores)),\n    }\n\n\ndef run_densenet121_epoch1():\n    cfg = dense_config\n    torch.manual_seed(cfg[\"seed\"])\n\n    saved = None\n    if dense_latest.is_file():\n        saved = torch.load(dense_latest, map_location=\"cpu\", weights_only=True)\n        assert saved[\"config\"] == cfg, \"Checkpoint settings differ from this run.\"\n        if saved[\"epoch\"] == 2:\n            print(\"DenseNet121 epoch 1 is already complete.\")\n            print(pd.read_csv(dense_history).to_string(index=False))\n            return\n        assert saved[\"epoch\"] == 1, \"Unexpected checkpoint epoch.\"\n\n    weights = DenseNet121_Weights.DEFAULT if saved is None else None\n    model = densenet121(weights=weights)\n    model.classifier = nn.Linear(model.classifier.in_features, 1)\n    model = model.to(dense_device)\n\n    optimizer = torch.optim.AdamW(model.parameters(), lr=cfg[\"learning_rate\"])\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode=\"max\", factor=0.5, patience=1\n    )\n    scaler = torch.amp.GradScaler(\"cuda\", init_scale=1024.0)\n    loss_fn = nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor([cfg[\"pos_weight\"]], device=dense_device)\n    )\n\n    train_stream = PEImageStream(\"train\", seed=cfg[\"seed\"])\n    validation_stream = PEImageStream(\"validation\")\n    assert len(train_stream) == 963_772\n    assert len(validation_stream) == 122_063\n\n    loader_options = {\n        \"batch_size\": cfg[\"batch_size\"],\n        \"num_workers\": 0,\n        \"pin_memory\": True,\n    }\n    train_loader = DataLoader(train_stream, **loader_options)\n    validation_loader = DataLoader(validation_stream, **loader_options)\n\n    batches_done = 0\n    totals = {\"loss_sum\": 0.0, \"slices\": 0, \"updates\": 0}\n\n    if saved is not None:\n        model.load_state_dict(saved[\"model\"])\n        optimizer.load_state_dict(saved[\"optimizer\"])\n        scheduler.load_state_dict(saved[\"scheduler\"])\n        scaler.load_state_dict(saved[\"scaler\"])\n        batches_done = saved[\"batches_done\"]\n        totals.update(saved[\"totals\"])\n        del saved\n\n    def save_latest(epoch, completed_batches, running_totals, history):\n        save_dense_checkpoint({\n            \"config\": cfg,\n            \"model\": model.state_dict(),\n            \"optimizer\": optimizer.state_dict(),\n            \"scheduler\": scheduler.state_dict(),\n            \"scaler\": scaler.state_dict(),\n            \"epoch\": epoch,\n            \"batches_done\": completed_batches,\n            \"totals\": running_totals,\n            \"history\": history,\n        }, dense_latest)\n\n    started_at = perf_counter()\n\n    if batches_done < len(train_loader):\n        resume_after = batches_done\n        print(\n            f\"DenseNet121 epoch 1: starting after {resume_after:,} saved batches.\",\n            flush=True,\n        )\n        if resume_after:\n            print(\"Replaying the loader to reach the saved batch.\", flush=True)\n\n        train_stream.set_epoch(0)\n        torch.manual_seed(cfg[\"seed\"] + 1)\n        model.train()\n\n        for batch_number, (images, labels, _) in enumerate(train_loader, start=1):\n            if batch_number <= resume_after:\n                continue\n\n            images = images.to(dense_device, non_blocking=True)\n            labels = labels.to(dense_device, non_blocking=True)\n\n            optimizer.zero_grad(set_to_none=True)\n            with torch.autocast(\"cuda\", dtype=torch.float16):\n                logits = model(images).squeeze(1)\n                loss = loss_fn(logits, labels)\n\n            if not torch.isfinite(loss).item():\n                raise FloatingPointError(f\"Non-finite training loss at batch {batch_number}.\")\n\n            scale_before = scaler.get_scale()\n            scaler.scale(loss).backward()\n            scaler.unscale_(optimizer)\n            nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            scaler.step(optimizer)\n            scaler.update()\n\n            totals[\"loss_sum\"] += loss.item() * labels.numel()\n            totals[\"slices\"] += labels.numel()\n            totals[\"updates\"] += int(scaler.get_scale() >= scale_before)\n            batches_done = batch_number\n\n            if batch_number % cfg[\"checkpoint_every\"] == 0:\n                save_latest(1, batches_done, totals, [])\n                print(\n                    f\"Epoch 1 | {batch_number:,}/{len(train_loader):,} batches | \"\n                    f\"mean loss={totals['loss_sum'] / totals['slices']:.4f} | \"\n                    \"saved latest.pt\",\n                    flush=True,\n                )\n\n    assert batches_done == len(train_loader)\n    assert totals[\"slices\"] == len(train_stream)\n    assert totals[\"updates\"] > 0\n\n    save_latest(1, batches_done, totals, [])\n    print(\"Training complete. Starting full validation.\", flush=True)\n\n    metrics = validate_densenet121(model, validation_loader, loss_fn)\n    scheduler.step(metrics[\"validation_ap\"])\n\n    result = {\n        \"epoch\": 1,\n        \"learning_rate\": cfg[\"learning_rate\"],\n        \"train_slices\": totals[\"slices\"],\n        \"successful_updates\": totals[\"updates\"],\n        \"train_loss\": totals[\"loss_sum\"] / totals[\"slices\"],\n        **metrics,\n        \"minutes_in_this_run\": (perf_counter() - started_at) / 60,\n    }\n\n    save_dense_checkpoint({\n        \"config\": cfg,\n        \"model\": model.state_dict(),\n        \"epoch\": 1,\n        **metrics,\n    }, dense_best)\n    pd.DataFrame([result]).to_csv(dense_history, index=False)\n    save_latest(2, 0, {}, [result])\n\n    print(\"\\n=== Stage 14B DenseNet121 results ===\")\n    print(pd.DataFrame([result]).round(4).to_string(index=False))\n    for path in (dense_latest, dense_best, dense_history):\n        print(f\"Saved: {path} ({path.stat().st_size / 1024**2:.2f} MiB)\")\n\n\nprint(f\"Stage 14B setup passed. Training pos_weight: {dense_config['pos_weight']:.4f}\")\nprint(f\"Outputs: {dense_dir}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T06:52:47.836811Z","iopub.execute_input":"2026-11-21T06:52:47.837647Z","iopub.status.idle":"2026-11-21T06:52:48.09119Z","shell.execute_reply.started":"2026-11-21T06:52:47.837617Z","shell.execute_